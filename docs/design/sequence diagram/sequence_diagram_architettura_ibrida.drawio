;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1785" y="30" width="170" height="50" as="geometry"/></mxCell><mxCell id="e16" value="" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1870" y="80" as="sourcePoint"/><mxPoint x="1870" y="2052" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="v17" value=": Filtro2&#10;Validazione" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2005" y="30" width="170" height="50" as="geometry"/></mxCell><mxCell id="e18" value="" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2090" y="80" as="sourcePoint"/><mxPoint x="2090" y="2052" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="v19" value=": Filtro1&#10;Ricezione" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2225" y="30" width="170" height="50" as="geometry"/></mxCell><mxCell id="e20" value="" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2310" y="80" as="sourcePoint"/><mxPoint x="2310" y="2052" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="v21" value="Dispositivo GPS&#10;(veicolo)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2565" y="20" width="30" height="50" as="geometry"/></mxCell><mxCell id="e22" value="" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2580" y="108" as="sourcePoint"/><mxPoint x="2580" y="2052" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="v23" value="Flusso 1 — Pipeline GPS&#10;(Pipes and Filters)&#10;&#10;Gira in background, indipendente dall'utente. Ogni posizione attraversa i filtri in sequenza; la posizione esatta dei veicoli privati non raggiunge mai il core (FEAT-02, Regola 2). Il Filtro3 legge dal core solo il tipo di proprietà del veicolo (scheda §3.1)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="15" y="170" width="255" height="175" as="geometry"/></mxCell><mxCell id="v24" value="Flusso 2 — Core transazionale&#10;(Monolite Modulare)&#10;&#10;US-03 mappa veicoli, poi US-04 / US-05 prenotazione. Verifica disponibilità, addebito e registrazione avvengono in un'unica transazione ACID: nessuna doppia prenotazione concorrente." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="15" y="1022" width="255" height="175" as="geometry"/></mxCell><mxCell id="v25" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=44;height=22;fontStyle=1;fontSize=11;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1810" y="564" width="255" height="106" as="geometry"/></mxCell><mxCell id="v26" value="[veicolo privato]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1882" y="564" width="101" height="14" as="geometry"/></mxCell><mxCell id="v27" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=44;height=22;fontStyle=1;fontSize=11;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1370" y="314" width="920" height="612" as="geometry"/></mxCell><mxCell id="e28" value="" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1370" y="824" as="sourcePoint"/><mxPoint x="2290" y="824" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="v29" value="[coordinate valide]" sty