<mxfile host="app.diagrams.net" agent="Claude"><diagram name="C4 L1 - System Context" id="c4l1systemcontext"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="C4 Livello 1 — System Context" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="500" height="24" as="geometry"/></mxCell><mxCell id="c2" value="Piattaforma Car/Bike Sharing tra privati con flotta aziendale (EPIC-001 Ecar)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="600" height="18" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Utente&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Cerca e prenota auto e bici, gestisce prenotazioni e abbonamenti, apre ticket (US01–US09, US12–US13)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="145" y="90" width="250" height="120" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;font-size:13px&quot;&gt;Privato condivisore&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Registra il proprio veicolo e lo mette in condivisione (US10)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="465" y="90" width="250" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;font-size:13px&quot;&gt;Operatore assistenza&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Gestisce i ticket e le emergenze in corsa (US12, US13)" style="rounded=1;arcSize=6;whiteSpace=wrap;ht