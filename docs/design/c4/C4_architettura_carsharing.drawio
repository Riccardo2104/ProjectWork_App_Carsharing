l><mxCell id="c33" value="«component»&lt;br&gt;&lt;b&gt;Modulo Veicoli e Posizioni&lt;/b&gt;&lt;br&gt;[Core Business API]" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1800" y="255" width="200" height="170" as="geometry"/></mxCell><mxCell id="c34" value="" style="shape=module;jettyWidth=8;jettyHeight=4;html=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1974" y="263" width="18" height="18" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=none;fontSize=10;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="1608" y="310" as="sourcePoint"/><mxPoint x="1688" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="" style="shape=providedRequiredInterface;html=1;verticalLabelPosition=bottom;direction=west;fillColor=default;" vertex="1" parent="1"><mxGeometry x="1688" y="298" width="24" height="24" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=none;fontSize=10;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="1712" y="310" as="sourcePoint"/><mxPoint x="1800" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="IAggiornaPosizione" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1630" y="278" width="140" height="16" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=none;fontSize=10;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="1608" y="370" as="sourcePoint"/><mxPoint x="1688" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="" style="shape=providedRequiredInterface;html=1;verticalLabelPosition=bottom;direction=west;fillColor=default;" vertex="1" parent="1"><mxGeometry x="1688" y="358" width="24" height="24" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=none;fontSize=10;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="1712" y="370" as="sourcePoint"/><mxPoint x="1800" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="IProprietaVeicolo" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1630" y="388" width="140" height="16" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=oval;endFill=0;endSize=14;fontSize=10;" edge="1" parent="1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="1010" y="162" as="sourcePoint"/><mxPoint x="1010" y="110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="IHealthCheck" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1026" y="100" width="90" height="16" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Comportamento dei filtri&lt;/b&gt;&lt;br&gt;• Filtro2 scarta i pacchetti con coordinate incoerenti (non inoltra nulla).&lt;br&gt;• Filtro3 offusca la posizione solo se il veicolo è di un privato: chiede il tipo proprietario&lt;br&gt;&amp;nbsp;&amp;nbsp;(flotta / privato) tramite IProprietaVeicolo (scheda §3.1). Il core non riceve mai la posizione&lt;br&gt;&amp;nbsp;&amp;nbsp;esatta di un privato (FEAT-02, Regola 2 — scheda comparativa V2).&lt;br&gt;• I filtri sono senza stato e testabili in isolamento (input → output)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470" y="460" width="640" height="110" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Interfacce e operazioni&lt;/b&gt; (scheda comparativa §3.1)&lt;br&gt;IRicezionePosizione — inviaPosizione(vehicleId, lat, lon, ts)&lt;br&gt;IValidazioneCoordinate — posizioneDecodificata(pacchetto)&lt;br&gt;IOffuscamentoPosizione — posizioneValidata(posizione)&lt;br&gt;IAggiornaPosizione — aggiornaPosizione(posizioneAggregata)&lt;br&gt;IProprietaVeicolo — tipoProprietario(vehicleId): flotta | privato (nota 1)&lt;br&gt;IHealthCheck — stato(): ultimo aggiornamento, filtri attivi (nota 2, mitigazione T1)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="420" y="680" width="520" height="130" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Legenda notazione&lt;/b&gt;&lt;br&gt;○—  interfaccia fornita (lollipop)&lt;br&gt;(○ &amp;nbsp;assembly: socket (richiesto) + ball (fornito)&lt;br&gt;□ &amp;nbsp;porta (port) sul bordo del componente&lt;br&gt;- - &amp;gt; &amp;nbsp;delegation verso il componente interno" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1000" y="680" width="340" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>